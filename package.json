{
  "name": "thumbor-client",
  "version": "0.4.0",
  "description": "Thumbor URL builder for Node, Bun, Deno, edge runtimes and browsers",
  "license": "MIT",
  "author": "azabroflovski",
  "homepage": "https://thumbor-js.broflovski.dev",
  "bugs": {
    "url": "https://github.com/azabroflovski/thumbor-client/issues"
  },
  "repository": {
    "url": "git+https://github.com/azabroflovski/thumbor-client.git",
    "type": "git"
  },
  "keywords": [
    "thumbor",
    "thumbor-client",
    "image",
    "resize",
    "url",
    "hmac",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/thumbor-client.cjs",
  "module": "./dist/thumbor-client.js",
  "types": "./dist/thumbor-client.d.ts",
  "unpkg": "./dist/thumbor-client.iife.js",
  "jsdelivr": "./dist/thumbor-client.iife.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/thumbor-client.d.ts",
        "default": "./dist/thumbor-client.js"
      },
      "require": {
        "types": "./dist/thumbor-client.d.cts",
        "default": "./dist/thumbor-client.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite demo",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node test/smoke.mjs && node test/smoke.cjs && node test/smoke-iife.cjs",
    "test:live": "node test/live.mjs",
    "thumbor": "docker compose up -d --wait",
    "typecheck": "tsc && tsc -p tsconfig.test.json && tsc -p demo",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && vite build demo --outDir ../docs/.vitepress/dist/playground --emptyOutDir",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "bun run docs:build && wrangler deploy",
    "release": "bun scripts/release.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsdown": "^0.23.0",
    "typescript": "^7",
    "vite": "^8",
    "vitepress": "^1.6.4",
    "vitest": "^5",
    "vue": "^3.5.43",
    "wrangler": "^4.147.0"
  }
}
